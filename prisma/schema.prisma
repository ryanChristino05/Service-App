generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Localisation {
  id Int @id @default(autoincrement())

  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)

  ville    String  @db.VarChar(191)
  quartier String? @db.VarChar(191)
  adresse  String? @db.VarChar(191)

  annonces Annonce[]
  services Service[]
  users    User[]

  @@map("localisation")
}

model User {
  id Int @id @default(autoincrement())

  nom    String  @db.VarChar(191)
  prenom String? @db.VarChar(191)

  email        String @unique @db.VarChar(191)
  mot_de_passe String @db.VarChar(255)

  role UserRole @default(STANDARD)

  photo_profil String? @db.VarChar(191)
  bio          String?
  telephone    String? @db.VarChar(50)

  localisation_id Int
  localisation    Localisation @relation(fields: [localisation_id], references: [id])

  date_creation      DateTime @default(now())
  date_modification  DateTime @updatedAt

  services             Service[]
  feedbacks            Feedback[]
  annonces             Annonce[]
  propositions_annonce PropositionAnnonce[]
  notifications        Notification[]
  sessions      Session[]
  @@index([localisation_id])
  @@map("users")
  
}

model Categorie {
  id Int @id @default(autoincrement())

  nom         String  @db.VarChar(191)
  description String?
  icone       String? @db.VarChar(191)

  services Service[]
  annonces Annonce[]

  @@map("categorie")
}

model Service {
  id Int @id @default(autoincrement())

  prestataire_id Int
  prestataire    User @relation(fields: [prestataire_id], references: [id])

  categorie_id Int
  categorie    Categorie @relation(fields: [categorie_id], references: [id])

  localisation_id Int
  localisation    Localisation @relation(fields: [localisation_id], references: [id])

  titre       String  @db.VarChar(255)
  description String? @db.Text


  statut ServiceStatus @default(EN_ATTENTE)

  date_creation     DateTime @default(now())
  date_modification DateTime @updatedAt

  images    ServiceImage[]
  feedbacks Feedback[]

  @@index([categorie_id])
  @@index([localisation_id])
  @@index([statut])
  @@index([prestataire_id])
  @@map("service")
}

model ServiceImage {
  id Int @id @default(autoincrement())

  service_id Int
  service    Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  url_image String @db.VarChar(255)
  ordre     Int?

  @@index([service_id])
  @@map("service_image")
}

model Feedback {
  id Int @id @default(autoincrement())

  service_id Int
  service    Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  auteur_id Int
  auteur    User @relation(fields: [auteur_id], references: [id])

  note        Int?
  commentaire String? @db.Text

  date_creation DateTime @default(now())

  @@unique([service_id, auteur_id], map: "unique_feedback")
  @@index([service_id])
  @@map("feedback")
}


model Annonce {
  id Int @id @default(autoincrement())

  demandeur_id Int
  demandeur    User @relation(fields: [demandeur_id], references: [id])

  categorie_id Int
  categorie    Categorie @relation(fields: [categorie_id], references: [id])

  localisation_id Int
  localisation    Localisation @relation(fields: [localisation_id], references: [id])

  titre       String  @db.VarChar(255)
  description String? @db.Text

  statut AnnonceStatus @default(ACTIVE)

  date_creation   DateTime  @default(now())
  date_expiration DateTime?

  propositions PropositionAnnonce[]

  @@index([categorie_id])
  @@index([localisation_id])
  @@index([demandeur_id])
  @@map("annonce")
}

model PropositionAnnonce {
  id Int @id @default(autoincrement())

  annonce_id Int
  annonce    Annonce @relation(fields: [annonce_id], references: [id], onDelete: Cascade)

  utilisateur_id Int
  utilisateur    User @relation(fields: [utilisateur_id], references: [id])

  message String?

  statut PropositionStatus @default(EN_ATTENTE)

  date_creation DateTime @default(now())

  @@index([annonce_id])
  @@map("proposition_annonce")
}

model Notification {
  id Int @id @default(autoincrement())

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type NotificationType?

  titre   String? @db.VarChar(191)
  contenu String?

  vu Boolean @default(false)

  date_creation DateTime @default(now())

  @@index([user_id])
  @@map("notification")
}

enum AnnonceStatus {
  ACTIVE
  EN_COURS
  RESOLUE
  EXPIREE
}

enum NotificationType {
  DEMANDE
  FEEDBACK
  SERVICE_VALIDE
  SERVICE_REFUSE
}

enum PropositionStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum ServiceStatus {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum UserRole {
  STANDARD
  PRESTATAIRE
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}